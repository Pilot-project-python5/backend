                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "인증번호 만료"
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "validation": {
                    "summary": "VALIDATION_FAILED",
                    "value": {
                      "error": {
                        "code": "VALIDATION_FAILED",
                        "fields": [],
                        "message": "요청 값을 확인해주세요.",
                        "request_id": "opaque-request-id"
                      }
                    }
                  }
                },
