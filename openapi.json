{
  "components": {
    "schemas": {
      "EmailVerificationConfirmRequest": {
        "examples": [
          {
            "code": "123456",
            "verification_id": "22222222-2222-4222-8222-222222222222"
          }
        ],
        "properties": {
          "code": {
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "type": "string"
          },
          "verification_id": {
            "format": "uuid",
            "title": "Verification Id",
            "type": "string"
          }
        },
        "required": [
          "verification_id",
          "code"
        ],
        "title": "EmailVerificationConfirmRequest",
        "type": "object"
      },
      "EmailVerificationConfirmResponse": {
        "examples": [
          {
            "email_verified_at": "2026-08-11T09:00:00Z",
            "status": "ACTIVE",
            "user_id": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "properties": {
          "email_verified_at": {
            "format": "date-time",
            "title": "Email Verified At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "status",
          "email_verified_at"
        ],
        "title": "EmailVerificationConfirmResponse",
        "type": "object"
      },
      "EmailVerificationIssueRequest": {
        "examples": [
          {
            "user_id": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "properties": {
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "EmailVerificationIssueRequest",
        "type": "object"
      },
      "EmailVerificationIssueResponse": {
        "examples": [
          {
            "expires_at": "2026-08-11T09:10:00Z",
            "resend_available_at": "2026-08-11T09:01:00Z",
            "verification_id": "22222222-2222-4222-8222-222222222222"
          }
        ],
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "resend_available_at": {
            "format": "date-time",
            "title": "Resend Available At",
            "type": "string"
          },
          "verification_id": {
            "format": "uuid",
            "title": "Verification Id",
            "type": "string"
          }
        },
        "required": [
          "verification_id",
          "expires_at",
          "resend_available_at"
        ],
        "title": "EmailVerificationIssueResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ErrorField"
            },
            "title": "Fields",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorField": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ErrorField",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Gender": {
        "enum": [
          "MALE",
          "FEMALE"
        ],
        "title": "Gender",
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginIdAvailabilityResponse": {
        "examples": [
          {
            "available": true,
            "login_id": "User123"
          }
        ],
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "login_id": {
            "title": "Login Id",
            "type": "string"
          }
        },
        "required": [
          "login_id",
          "available"
        ],
        "title": "LoginIdAvailabilityResponse",
        "type": "object"
      },
      "SignupRequest": {
        "examples": [
          {
            "birth_date": "1995-05-20",
            "email": "user@example.com",
            "gender": "MALE",
            "height_cm": 175,
            "login_id": "User123",
            "name": "홍길동",
            "password": "Safe!Pass123",
            "password_confirmation": "Safe!Pass123",
            "weight_kg": 70
          }
        ],
        "properties": {
          "birth_date": {
            "format": "date",
            "title": "Birth Date",
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "height_cm": {
            "anyOf": [
              {
                "maximum": 250.0,
                "minimum": 50.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,3}|(?=[\\d.]{1,6}0*$)\\d{0,3}\\.\\d{0,2}0*$)",
                "type": "string"
              }
            ],
            "title": "Height Cm"
          },
          "login_id": {
            "maxLength": 20,
            "minLength": 5,
            "pattern": "^[A-Za-z0-9]+$",
            "title": "Login Id",
            "type": "string"
          },
          "name": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 20,
            "minLength": 8,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "password_confirmation": {
            "format": "password",
            "maxLength": 20,
            "minLength": 8,
            "title": "Password Confirmation",
            "type": "string",
            "writeOnly": true
          },
          "weight_kg": {
            "anyOf": [
              {
                "maximum": 500.0,
                "minimum": 10.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,4}|(?=[\\d.]{1,7}0*$)\\d{0,4}\\.\\d{0,2}0*$)",
                "type": "string"
              }
            ],
            "title": "Weight Kg"
          }
        },
        "required": [
          "name",
          "login_id",
          "password",
          "password_confirmation",
          "email",
          "birth_date",
          "gender",
          "height_cm",
          "weight_kg"
        ],
        "title": "SignupRequest",
        "type": "object"
      },
      "SignupResponse": {
        "examples": [
          {
            "created_at": "2026-08-10T09:00:00Z",
            "email": "user@example.com",
            "email_verification_required": true,
            "id": "11111111-1111-4111-8111-111111111111",
            "login_id": "User123",
            "status": "PENDING_EMAIL_VERIFICATION"
          }
        ],
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "email_verification_required": {
            "default": true,
            "title": "Email Verification Required",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "login_id": {
            "title": "Login Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          }
        },
        "required": [
          "id",
          "login_id",
          "email",
          "status",
          "created_at"
        ],
        "title": "SignupResponse",
        "type": "object"
      },
      "SignupValidationIssue": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "SignupValidationIssue",
        "type": "object"
      },
      "SignupValidationResponse": {
        "examples": [
          {
            "issues": [
              {
                "code": "AUTH_LOGIN_ID_UNAVAILABLE",
                "field": "login_id",
                "message": "사용할 수 없는 아이디입니다."
              }
            ],
            "valid": false
          }
        ],
        "properties": {
          "issues": {
            "items": {
              "$ref": "#/components/schemas/SignupValidationIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "valid"
        ],
        "title": "SignupValidationResponse",
        "type": "object"
      },
      "UserStatus": {
        "enum": [
          "PENDING_EMAIL_VERIFICATION",
          "ACTIVE",
          "SUSPENDED"
        ],
        "title": "UserStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "알약꾹 1차 로컬 MVP 백엔드 API",
    "title": "알약꾹 백엔드",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/email-verifications": {
      "post": {
        "operationId": "auth_issue_email_verification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerificationIssueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailVerificationIssueResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "examples": {
                  "not_found": {
                    "summary": "RESOURCE_NOT_FOUND",
                    "value": {
                      "error": {
                        "code": "RESOURCE_NOT_FOUND",
                        "fields": [],
                        "message": "요청한 리소스를 찾을 수 없습니다.",
                        "request_id": "opaque-request-id"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "사용자를 찾을 수 없음"
          },
          "409": {
            "content": {
              "application/json": {
                "examples": {
                  "account_not_active": {
                    "summary": "AUTH_VERIFICATION_NOT_ACTIVE",
                    "value": {
                      "error": {
                        "code": "AUTH_VERIFICATION_NOT_ACTIVE",
                        "fields": [],
                        "message": "이메일 인증을 진행할 수 없는 계정 상태입니다.",
                        "request_id": "opaque-request-id"
                      }
                    }
                  },
                  "already_verified": {
                    "summary": "AUTH_EMAIL_ALREADY_VERIFIED",
                    "value": {
                      "error": {
                        "code": "AUTH_EMAIL_ALREADY_VERIFIED",
                        "fields": [],
                        "message": "이미 이메일 인증이 완료되었습니다.",
                        "request_id": "opaque-request-id"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "이미 이메일 인증 완료"
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "validation": {
                    "summary": "VALIDATION_FAILED",
                    "value": {
                      "error": {
                        "code": "VALIDATION_FAILED",
                        "fields": [],
                        "message": "요청 값을 확인해주세요.",
                        "request_id": "opaque-request-id"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "요청 형식 검증 실패"
          },
          "429": {
            "content": {
              "application/json": {
                "examples": {
                  "too_soon": {
                    "summary": "AUTH_VERIFICATION_RESEND_TOO_SOON",
                    "value": {
                      "error": {
                        "code": "AUTH_VERIFICATION_RESEND_TOO_SOON",
                        "fields": [],
                        "message": "잠시 후 인증번호를 다시 요청해주세요.",
                        "request_id": "opaque-request-id"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "재전송 대기 시간 미경과"
          },
          "503": {
            "content": {
              "application/json": {
                "examples": {
                  "unavailable": {
                    "summary": "SERVICE_UNAVAILABLE",
                    "value": {
                      "error": {
                        "code": "SERVICE_UNAVAILABLE",
                        "fields": [],
                        "message": "서비스가 아직 준비되지 않았습니다.",
                        "request_id": "opaque-request-id"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "PostgreSQL 또는 SMTP 처리 실패"
          }
        },
        "summary": "이메일 인증번호 발급",
        "tags": [
          "인증"
        ]
      }
    },
    "/api/v1/auth/email-verifications/confirm": {
